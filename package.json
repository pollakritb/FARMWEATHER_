{
  "name": "farmweather",
  "version": "0.2.0",
  "private": true,
  "description": "NestJS MVP for plot-based agricultural weather advisories using TMD forecasts",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:fresh": "node --env-file=.env -r ts-node/register scripts/database-seed.ts",
    "mock": "npx -y @stoplight/prism-cli mock openapi.json",
    "mock:dynamic": "npx -y @stoplight/prism-cli mock openapi.json --dynamic",
    "proxy:validate": "npx -y @stoplight/prism-cli proxy openapi.json http://localhost:3000 --errors",
    "test": "jest",
    "test:live": "node scripts/live-openapi-smoke.mjs",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "sonar:up": "docker compose --profile sonar up -d sonarqube",
    "sonar:down": "docker compose --profile sonar stop sonarqube",
    "sonar:scan": "docker run --rm --network host -e SONAR_HOST_URL=http://localhost:9000 -e SONAR_TOKEN -v \"$PWD:/usr/src\" sonarsource/sonar-scanner-cli"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "axios": "^1.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
