# Local development connects to the PostgreSQL port published by Docker Compose.
DATABASE_URL=postgresql://farmer:farmer@localhost:5433/farmer_weather
PORT=3000
APP_PORT=3000

# Replace this with a long random value outside local development.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PASSWORD_RESET_EXPOSE_TOKEN=true
CORS_ORIGIN=http://localhost:3000

# Demo mode works without a TMD token.
WEATHER_DEMO_MODE=true
TMD_ACCESS_TOKEN=
TMD_OBSERVATION_UID=api
TMD_OBSERVATION_UKEY=api12345

# Optional seed accounts used by npm run db:fresh.
SEED_ADMIN_USERNAME=replace-admin-username
SEED_ADMIN_PASSWORD=ReplaceWithAStrongAdminPassword1!
SEED_FARMER_USERNAME=replace-farmer-username
SEED_FARMER_PASSWORD=ReplaceWithAStrongFarmerPassword1!
