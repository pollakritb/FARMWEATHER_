PORT=3000
DATABASE_URL=postgresql://farmer:farmer@localhost:5433/farmer_weather
# Production refuses to start without DATABASE_URL. Enable this only for disposable previews.
ALLOW_IN_MEMORY_STORAGE=false
AUTH_SECRET=change-this-to-a-long-random-secret
# The account registered with this username receives the ADMIN role.
ADMIN_USERNAME=admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_FARMER_USERNAME=farmer
SEED_FARMER_PASSWORD=Farmer123!
TMD_BASE_URL=https://data.tmd.go.th/nwpapi/v1
TMD_ACCESS_TOKEN=
EXPOSE_RESET_TOKEN=true
WEATHER_DEMO_MODE=
TMD_TIMEOUT_MS=10000
WEATHER_CRON=0 */3 * * *
WEATHER_CACHE_MINUTES=180
OBSERVATION_CACHE_MINUTES=10
OBSERVATION_MAX_AGE_HOURS=6
TMD_OBSERVATION_URL=https://data.tmd.go.th/api/Weather3Hours/V2/
TMD_OBSERVATION_UID=api
TMD_OBSERVATION_UKEY=api12345
